---
// Einheitlicher Allergie-Hinweis (LMIV) — Speisekarte, Konfigurator und
// Zutaten-Galerie nutzen denselben Wortlaut. `class` erlaubt Abstände am
// Einsatzort, ohne die Optik zu duplizieren.
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<aside
  data-allergen-notice
  class={`rounded-xl border border-brand-gold/40 bg-brand-charcoal/60 p-4 sm:p-5 flex items-start gap-3 ${className}`}
>
  <span class="text-brand-gold text-lg leading-none shrink-0" aria-hidden="true">ⓘ</span>
  <p class="text-sm text-brand-cream/85 leading-relaxed">
    <strong class="text-brand-cream">Allergien oder Unverträglichkeiten?</strong>
    Bitte sprechen Sie uns vor Ihrer Bestellung an. Wir informieren Sie gerne über
    die enthaltenen Allergene und Zutaten unserer Speisen und Soßen.
  </p>
</aside>
